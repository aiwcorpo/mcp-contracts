// Cedar model of the MCP platform (contract C7), mcp-contracts 1.2.1.
//
// Validated in strict mode. Cedar has no null: anything that may be missing is an optional attribute
// and policies must guard it with `has`.
//
// Two evaluations use this schema (C7):
//   gateway: principal User, Action::"call", resource Tool, context built from the tool's resourceRefs
//   server:  principal User, Action::"read" | "update" | "delete" | "admin", resource = resolved system entity
// How principal.scopes, context.vsScopes, context.refs and resource.scopes are derived is specified in
// cedar/entity-builder.md. Every system resource carries `scopes`: the ResourceScope ids of itself and all
// its containers (project of an issue, every ancestor group path, every dash prefix of an index name, space
// and ancestor pages of a page), so `principal in resource.scopes` covers subgroups and page trees.

// A grantable resource scope (CC-037). Id "<ResourceType>/<id>", e.g. "Jira::Project/ABC",
// "GitLab::Group/team-a", "OpenSearch::Index/logs-team-a", "Confluence::Page/1234". Which group grants which
// scope is DATA: the main policy bundle's entities/static.json lists UserGroup entities whose parents are
// ResourceScope entities. A group without such an entry grants nothing (fail-closed).
entity ResourceScope;

// Scopes granted to the user, from the bundle's mapping (see above). Always present; empty = nothing granted.
// Only exact ids: the gateway uses it for early checks of flat types (Jira projects, Confluence spaces,
// service desk queues). Hierarchical checks use `principal in resource.scopes` on the server.
type Scopes = {
  jiraProjects: Set<ResourceScope>,
  confluenceSpaces: Set<ResourceScope>,
  gitlabGroups: Set<ResourceScope>,
  opensearchIndexPrefixes: Set<ResourceScope>,
  servicedeskQueues: Set<ResourceScope>,
};

// Narrowing of the virtual server, from the vsc claim (CC-027). An absent field means "this link does not
// narrow this resource type". Policies may read vsScopes only in forbid rules (CC-041).
type VsScopes = {
  jiraProjects?: Set<ResourceScope>,
  confluenceSpaces?: Set<ResourceScope>,
  gitlabGroups?: Set<ResourceScope>,
  opensearchIndexPrefixes?: Set<ResourceScope>,
  servicedeskQueues?: Set<ResourceScope>,
};

// Identifiers taken only from tool arguments declared in resourceRefs (C6). A field is present exactly
// when the tool declares a resourceRef of that type. Ids of grantable flat types become ResourceScope
// entities so they compare with Scopes and VsScopes; the others stay plain strings.
type Refs = {
  jiraProject?: Set<ResourceScope>,
  jiraIssue?: Set<String>,
  confluenceSpace?: Set<ResourceScope>,
  confluencePage?: Set<String>,
  gitlabGroup?: Set<ResourceScope>,
  gitlabProject?: Set<String>,
  opensearchIndex?: Set<String>,
  servicedeskQueue?: Set<ResourceScope>,
  servicedeskTicket?: Set<String>,
};

type RequestContext = {
  client: String,
  virtualServer?: String,
  vsScopes?: VsScopes,
  mfaAge?: Long,
  refs?: Refs,
};

// Called UserGroup, not Group: Cedar 4 rejects a top-level Group next to GitLab::Group (shadowing). See CC-001.
// Parents (ResourceScope) come only from entities/static.json of the main bundle.
entity UserGroup in [ResourceScope];

// Entity id = `sub` from C1/C2. Parents = the user's mcp-* groups.
entity User in [UserGroup] {
  username: String,
  client: String,
  mfaAge?: Long,
  scopes: Scopes,
};

// Entity id = client-visible tool name <system>__<tool> (C5).
entity Tool {
  server: String,
  name: String,
  risk: String,
};

namespace Jira {
  entity Project {
    key: String,
    category?: String,
    scopes: Set<ResourceScope>,
  };
  // `project` duplicates the parent edge because Cedar cannot read attributes of an ancestor through `in`.
  entity Issue in [Project] {
    key: String,
    project: Project,
    scopes: Set<ResourceScope>,
  };
}

namespace Confluence {
  entity Space {
    key: String,
    labels: Set<String>,
    scopes: Set<ResourceScope>,
  };
  // ancestorIds: ids of the ancestor pages as reported by Confluence (page tree scopes, CC-037).
  entity Page in [Space] {
    id: String,
    space: Space,
    ancestorIds?: Set<String>,
    scopes: Set<ResourceScope>,
  };
}

namespace GitLab {
  entity Group {
    path: String,
    scopes: Set<ResourceScope>,
  };
  entity Project in [Group] {
    path: String,
    group: Group,
    scopes: Set<ResourceScope>,
  };
}

namespace OpenSearch {
  entity Index {
    name: String,
    tags: Set<String>,
    scopes: Set<ResourceScope>,
  };
}

namespace ServiceDesk {
  entity Queue {
    id: String,
    scopes: Set<ResourceScope>,
  };
  entity Ticket in [Queue] {
    id: String,
    queue: Queue,
    scopes: Set<ResourceScope>,
  };
}

action "call" appliesTo {
  principal: [User],
  resource: [Tool],
  context: RequestContext,
};

action "read", "update", "delete", "admin" appliesTo {
  principal: [User],
  resource: [
    Jira::Project, Jira::Issue,
    Confluence::Space, Confluence::Page,
    GitLab::Group, GitLab::Project,
    OpenSearch::Index,
    ServiceDesk::Queue, ServiceDesk::Ticket
  ],
  context: RequestContext,
};
