// Cedar base schema of the MCP platform (contract C7), mcp-contracts 7.0.0, empty namespace.
//
// It names no system, server or resource type. Each MCP server brings a fragment with exactly one namespace of its
// own (its resource types and its actions); the gateway and the starter compose this file with the fragment text
// (see cedar/entity-builder.md, section "Fragment serwera") and validate in strict mode. Cedar has no null: anything
// that may be missing is an optional attribute and policies must guard it with `has`.
//
// Two evaluations use the composed schema (C7):
//   gateway: principal User, Action::"call", resource Tool, policies of cedar/platform plus emergency overrides
//   server:  principal User, <Ns>::Action::"read" | "update" | "delete" | "admin", resource = a type of the server
//            namespace, the server's own policies only
// How User.scopes, Tool.requiredGroup, context.refs and the scopes of a server resource are derived is specified in
// cedar/entity-builder.md.

// A grantable resource scope. Id "<Namespace>::<Type>/<id>", e.g. "Jira::Project/ABC". Which group grants which scope is
// administrator data (the scope mapping served by the gateway); a group without an entry grants nothing (fail-closed).
entity ResourceScope;

// Called UserGroup, not Group: Cedar 4 rejects a top-level Group next to a namespaced type of the same name (CC-001).
// Parents (ResourceScope) come from the scope mapping.
entity UserGroup in [ResourceScope];

// Entity id = `sub` from C1/C2. Parents = the user's mcp-* groups. `scopes` is one flat set of every ResourceScope the
// user's groups are mapped to (exact ids, for the early check at the gateway); hierarchical checks use
// `principal in resource.scopes` on the server.
entity User in [UserGroup] {
  username: String,
  client: String,
  mfaAge?: Long,
  scopes: Set<ResourceScope>,
};

// Entity id = client-visible tool name <system>__<tool> (C5). requiredGroup is mcp-<system>-read for READ_ONLY,
// mcp-<system>-write for UPDATE and mcp-<system>-destructive for DESTRUCTIVE (C9): the only place where a group name is
// derived. additionalGroup is the optional group the manifest names for one tool (mcp-<system>-<suffix>, e.g. an ops-only
// tool); it can only narrow, because the risk-derived requiredGroup is still needed.
entity Tool {
  server: String,
  name: String,
  risk: String,
  requiredGroup: UserGroup,
  additionalGroup?: UserGroup,
};

// credentialType: the type of the credential used for the call (user-oauth, user-secret, token-exchange or
// service-account), from the configuration of the system. Optional in the model so that a caller of the builder that does
// not know it can still build a request; policies guard it with `has`.
// refs: ResourceScope ids "<Type>/<id>" built from the tool arguments whose resourceRef type is declared
// earlyScopeCheck. Always present at the gateway (may be empty).
type RequestContext = {
  client: String,
  mfaAge?: Long,
  credentialType?: String,
  refs?: Set<ResourceScope>,
};

action "call" appliesTo {
  principal: [User],
  resource: [Tool],
  context: RequestContext,
};
