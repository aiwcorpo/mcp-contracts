    },
    {
      "name": "getCatalog 401 unauthenticated",
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPathTemplate": "/admin/v1/catalog",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=unauthenticated($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "unauthenticated"
        }
      }
    },
    {
      "name": "getCatalog 403 access_denied",
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPathTemplate": "/admin/v1/catalog",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=access_denied($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "access_denied"
        }
