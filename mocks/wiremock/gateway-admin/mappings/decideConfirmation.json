{
  "mappings": [
    {
      "name": "decideConfirmation without bearer token",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/admin/v1/confirmations/{confirmationId}",
        "headers": {
          "Authorization": {
            "absent": true
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "unauthenticated"
        }
      }
    },
    {
      "name": "decideConfirmation 204 status-204",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/admin/v1/confirmations/{confirmationId}",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          }
        }
      },
      "response": {
        "status": 204
      }
    },
    {
      "name": "decideConfirmation 401 step_up_required",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/admin/v1/confirmations/{confirmationId}",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=step_up_required($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "step_up_required",
          "stepUpUrl": "https://mcp-portal.internal/api/v1/auth/login?returnPath=%2Fconfirm"
        }
      }
    },
    {
      "name": "decideConfirmation 403 access_denied",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/admin/v1/confirmations/{confirmationId}",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=access_denied($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "access_denied"
        }
      }
    },
    {
      "name": "decideConfirmation 404 not_found_or_denied",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/admin/v1/confirmations/{confirmationId}",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=not_found_or_denied($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 404,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "not_found_or_denied"
        }
      }
    }
  ]
}
