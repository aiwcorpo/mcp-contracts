{
  "mappings": [
    {
      "name": "completeOAuth without bearer token",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/v1/connections/{system}/oauth/complete",
        "headers": {
          "Authorization": {
            "absent": true
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "unauthenticated"
        }
      }
    },
    {
      "name": "completeOAuth 200 connected",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/v1/connections/{system}/oauth/complete",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "status": "connected",
          "backendUser": "jkowalski"
        }
      }
    },
    {
      "name": "completeOAuth 401 unauthenticated",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/v1/connections/{system}/oauth/complete",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=unauthenticated($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "unauthenticated"
        }
      }
    },
    {
      "name": "completeOAuth 422 identity_mismatch",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/v1/connections/{system}/oauth/complete",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=identity_mismatch($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "identity_mismatch"
        }
      }
    },
    {
      "name": "completeOAuth 422 flow_invalid",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPathTemplate": "/v1/connections/{system}/oauth/complete",
        "headers": {
          "Authorization": {
            "matches": "^Bearer .+$"
          },
          "Prefer": {
            "matches": "(^|.*[ ,;])example=flow_invalid($|[ ,;].*)"
          }
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "jsonBody": {
          "error": "flow_invalid"
        }
      }
    }
  ]
}
