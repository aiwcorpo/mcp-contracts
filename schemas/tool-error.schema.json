{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool error (C10)",
  "description": "JSON carried in the text content of an MCP tool result with isError: true. One variant per error code; only the fields listed for a code are allowed.",
  "oneOf": [
    {
      "$ref": "#/$defs/Unauthenticated"
    },
    {
      "$ref": "#/$defs/AccessDenied"
    },
    {
      "$ref": "#/$defs/ToolDisabled"
    },
    {
      "$ref": "#/$defs/ConfirmationRequired"
    },
    {
      "$ref": "#/$defs/ConfirmationFailed"
    },
    {
      "$ref": "#/$defs/CredentialRequired"
    },
    {
      "$ref": "#/$defs/NotFoundOrDenied"
    },
    {
      "$ref": "#/$defs/InvalidArgument"
    },
    {
      "$ref": "#/$defs/RateLimited"
    },
    {
      "$ref": "#/$defs/StepUpRequired"
    },
    {
      "$ref": "#/$defs/UpstreamUnavailable"
    },
    {
      "$ref": "#/$defs/InternalError"
    }
  ],
  "$defs": {
    "Message": {
      "description": "Safe text for the user. Never contains backend responses, secrets, argument values or stack traces.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "Unauthenticated": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "unauthenticated"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "AccessDenied": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "access_denied"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "requiredEntitlements": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/GroupName"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ToolDisabled": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "tool_disabled",
          "description": "Only when an administrator disabled the tool or its server, or its definition waits for approval. A tool that is not in the tool list of the virtual server (link) used for the call is not_found_or_denied (CC-118)."
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "ConfirmationRequired": {
      "description": "The confirmation of a destructive call is the current code of the user's TOTP authenticator (C11, CC-091). One of two shapes: a pending call exists (confirmationId, description, previewUrl, expiresAt) or the user has no authenticator and only registerUrl is given.",
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "confirmation_required"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "confirmationId": {
          "$ref": "common.schema.json#/$defs/ConfirmationId"
        },
        "description": {
          "description": "Operation as the gateway computed it from the arguments it received: qualified tool name, system and arguments sorted by name, JSON-serialized, truncated like ConfirmationView. Not model text. Unlike message it carries argument values (the client already has them). A client shows it to the user, but a client is untrusted: the portal preview is the reference.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "previewUrl": {
          "description": "Read-only portal page /confirm/<confirmationId> (owner only, a session without fresh MFA is enough). Opening it is optional.",
          "type": "string",
          "format": "uri"
        },
        "registerUrl": {
          "description": "Portal page where the user registers the authenticator. Present exactly when the user has no active authenticator; no pending call exists then.",
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "oneOf": [
        {
          "required": [
            "confirmationId",
            "description",
            "previewUrl",
            "expiresAt"
          ],
          "not": {
            "required": [
              "registerUrl"
            ]
          }
        },
        {
          "required": [
            "registerUrl"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "confirmationId"
                ]
              },
              {
                "required": [
                  "description"
                ]
              },
              {
                "required": [
                  "previewUrl"
                ]
              },
              {
                "required": [
                  "expiresAt"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ConfirmationFailed": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "confirmation_failed",
          "description": "No pending call, expired, arguments different from the first call, wrong or already used code, or attempts exhausted (C11, CC-091)."
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "CredentialRequired": {
      "type": "object",
      "required": [
        "error",
        "message",
        "system",
        "connectUrl"
      ],
      "properties": {
        "error": {
          "const": "credential_required"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "system": {
          "$ref": "common.schema.json#/$defs/SystemId"
        },
        "connectUrl": {
          "description": "Portal page where the user connects the account.",
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "NotFoundOrDenied": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "description": "Also the answer for a tool outside the tool list of the virtual server (link) used for the call, so that the link does not reveal tools it does not contain (CC-118, invariant 8).",
          "const": "not_found_or_denied"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "InvalidArgument": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "invalid_argument"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "RateLimited": {
      "type": "object",
      "required": [
        "error",
        "message",
        "retryAfterSeconds"
      ],
      "properties": {
        "error": {
          "const": "rate_limited"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "StepUpRequired": {
      "type": "object",
      "required": [
        "error",
        "message",
        "stepUpUrl"
      ],
      "properties": {
        "error": {
          "const": "step_up_required"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "stepUpUrl": {
          "description": "Portal URL that re-authenticates with max_age/acr_values.",
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "UpstreamUnavailable": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "upstream_unavailable"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    },
    "InternalError": {
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "const": "internal_error"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "additionalProperties": false
    }
  }
}
