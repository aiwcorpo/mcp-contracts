{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP server manifest (C6)",
  "description": "Generated by the starter at build time (target/mcp-manifest.json), served at GET /mcp-manifest (requires C2) and registered with PUT /admin/v1/registry/servers/{serverId} (C5). Rules checked in addition to this schema (see README, 'Regu\u0142y semantyczne'): serverId == 'mcp-' + system; tool names unique; every resourceRefs[].type and resourceTypes[].parent is declared in resourceTypes; resourceTypes[].type unique.",
  "type": "object",
  "required": [
    "serverId",
    "version",
    "system",
    "internalUrl",
    "credential",
    "resourceTypes",
    "tools"
  ],
  "properties": {
    "serverId": {
      "$ref": "common.schema.json#/$defs/ServerId"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/SemVer"
    },
    "system": {
      "$ref": "common.schema.json#/$defs/SystemId"
    },
    "internalUrl": {
      "description": "Informational. The gateway takes serverId -> system/internalUrl only from its own configuration and rejects a manifest that disagrees (C5).",
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "credential": {
      "type": "object",
      "required": [
        "required",
        "acceptedTypes"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "acceptedTypes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/CredentialType"
          },
          "uniqueItems": true
        }
      },
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "acceptedTypes": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/CredentialType"
            },
            "minItems": 1
          }
        }
      },
      "additionalProperties": false
    },
    "resourceTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceTypeDeclaration"
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ToolEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ResourceTypeDeclaration": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/ResourceType"
        },
        "attributes": {
          "description": "Attributes the server's resolver fills from the system (Cedar entity attributes).",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "uniqueItems": true
        },
        "parent": {
          "$ref": "common.schema.json#/$defs/ResourceType"
        }
      },
      "additionalProperties": false
    },
    "ResourceRef": {
      "type": "object",
      "required": [
        "argument",
        "type"
      ],
      "properties": {
        "argument": {
          "description": "Name of a top-level argument of the tool's inputSchema whose value is a resource id (string or array of strings).",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "type": {
          "$ref": "common.schema.json#/$defs/ResourceType"
        }
      },
      "additionalProperties": false
    },
    "ToolEntry": {
      "description": "Manifest entry of one tool. Every tool that accepts a resource identifier MUST declare resourceRefs (C6).",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/ToolEntryFields"
        }
      ],
      "unevaluatedProperties": false
    },
    "ToolEntryFields": {
      "description": "Fields of a manifest tool entry, open for composition (used by the gateway registry API).",
      "type": "object",
      "required": [
        "name",
        "risk",
        "action",
        "resourceRefs",
        "definitionHash"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/ToolName"
        },
        "risk": {
          "$ref": "common.schema.json#/$defs/Risk"
        },
        "action": {
          "$ref": "common.schema.json#/$defs/ToolAction"
        },
        "resourceRefs": {
          "description": "Always present; an empty array when the tool takes no resource identifier (one canonical form for definitionHash).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "definitionHash": {
          "$ref": "common.schema.json#/$defs/DefinitionHash"
        }
      }
    }
  }
}
