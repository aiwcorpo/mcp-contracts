{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Internal JWT claims (C2)",
  "description": "Payload of the ES256 JWT issued by the gateway for MCP servers and the credential broker. Rules that a schema cannot express and that receivers MUST check: signature against the gateway JWKS, iss, aud == own id, exp with clock skew <= 30 s, iat not more than 30 s in the future, exp - iat <= 60 s, jti not seen within its validity window, rid == X-Request-Id header, tools/call only with the user variant and tool == params.name, service variant only for initialize, tools/list, ping, GET /mcp-manifest and (broker) GET /v1/systems. Production receivers reject any kid starting with 'test-' (configurable), so a token signed with the published test keys never passes. Any failure -> HTTP 401.",
  "oneOf": [
    {
      "$ref": "#/$defs/UserClaims"
    },
    {
      "$ref": "#/$defs/ServiceClaims"
    }
  ],
  "$defs": {
    "Header": {
      "description": "JOSE header. Receivers accept only ES256 and only a kid present in the gateway JWKS; production receivers also reject kid values starting with 'test-'.",
      "type": "object",
      "required": [
        "alg",
        "kid"
      ],
      "properties": {
        "alg": {
          "const": "ES256"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "typ": {
          "const": "JWT"
        }
      }
    },
    "Common": {
      "type": "object",
      "properties": {
        "iss": {
          "description": "Gateway issuer, default https://mcp-gateway.internal (configurable).",
          "type": "string",
          "format": "uri"
        },
        "aud": {
          "description": "Id of the receiving component: mcp-<system> or mcp-credential-broker. A single string, never an array.",
          "$ref": "common.schema.json#/$defs/ComponentId"
        },
        "rid": {
          "$ref": "common.schema.json#/$defs/RequestId"
        },
        "prv": {
          "$ref": "common.schema.json#/$defs/PolicyRevision"
        },
        "iat": {
          "type": "integer",
          "minimum": 0
        },
        "exp": {
          "type": "integer",
          "minimum": 0
        },
        "jti": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "UserClaims": {
      "description": "Call on behalf of a user. The only variant accepted for tools/call and by the broker resolve endpoint.",
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        }
      ],
      "type": "object",
      "required": [
        "iss",
        "aud",
        "sub",
        "usr",
        "grp",
        "azp",
        "tool",
        "rid",
        "prv",
        "iat",
        "exp",
        "jti"
      ],
      "properties": {
        "sub": {
          "description": "sub from the IdP token (C1), unchanged.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "not": {
            "pattern": "^system:"
          }
        },
        "usr": {
          "description": "preferred_username",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "grp": {
          "description": "User groups from C9, only those with the mcp- prefix.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/GroupName"
          },
          "uniqueItems": true
        },
        "azp": {
          "description": "OAuth client id of the AI client (C1).",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "vs": {
          "$ref": "common.schema.json#/$defs/VirtualServerSlug"
        },
        "vsc": {
          "description": "Narrowing of the virtual server (CC-027): resourceDefaults of the link mapped to the vsScopes fields of the Cedar model. Present exactly when vs is present; {} when the link does not narrow resources. Servers build context.vsScopes from it.",
          "type": "object",
          "properties": {
            "jiraProjects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "confluenceSpaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "gitlabGroups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "opensearchIndexPrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "servicedeskQueues": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "tool": {
          "$ref": "common.schema.json#/$defs/ToolName"
        },
        "mfa": {
          "description": "Seconds since the last authentication at an MFA acr level. Absent means unknown.",
          "type": "integer",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false,
      "dependentRequired": {
        "vs": [
          "vsc"
        ],
        "vsc": [
          "vs"
        ]
      }
    },
    "ServiceClaims": {
      "description": "Gateway call without a user. Accepted only for initialize, tools/list, ping and GET /mcp-manifest.",
      "allOf": [
        {
          "$ref": "#/$defs/Common"
        }
      ],
      "type": "object",
      "required": [
        "iss",
        "aud",
        "sub",
        "grp",
        "rid",
        "prv",
        "iat",
        "exp",
        "jti"
      ],
      "properties": {
        "sub": {
          "const": "system:mcp-gateway"
        },
        "grp": {
          "type": "array",
          "maxItems": 0
        }
      },
      "unevaluatedProperties": false
    }
  }
}
