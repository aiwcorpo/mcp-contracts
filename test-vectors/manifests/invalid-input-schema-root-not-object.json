    "policies": {
      "namespace": "Jira",
      "schema": "// Fragment of a Jira MCP server: one namespace, the server's own. Base types (User, ResourceScope, RequestContext) are\n// referenced unqualified from the empty namespace of cedar/mcp.cedarschema. Every entity type has `scopes`.\n\nnamespace Jira {\n  entity Project {\n    key: String,\n    // Classification: required, \"\" when the project has no category. The entity builder normalizes it (trim, ASCII lower\n    // case); the canonical value for restricted data is \"restricted\".\n    category: String,\n    scopes: Set<ResourceScope>,\n  };\n  // `project` duplicates the parent edge because Cedar cannot read attributes of an ancestor through `in`.\n  entity Issue in [Project] {\n    key: String,\n    project: Project,\n    scopes: Set<ResourceScope>,\n  };\n\n  action \"read\", \"update\", \"delete\", \"admin\" appliesTo {\n    principal: [User],\n    resource: [Project, Issue],\n    context: RequestContext,\n  };\n}\n",
      "files": [
        {
          "name": "read.cedar",
          "text": "// Reading follows the user's own rights in Jira; the server adds the group check and the classification rule.\n\n@id(\"jira-read\")\npermit (\n  principal in UserGroup::\"mcp-jira-read\",\n  action == Jira::Action::\"read\",\n  resource\n)\nwhen { resource is Jira::Project || resource is Jira::Issue };\n"
        },
        {
          "name": "update.cedar",
          "text": "// Changes only inside the projects granted by the scope mapping. `principal in resource.scopes` is true when one of the\n// user's groups is mapped to the resource scope; an issue carries the scope of its project.\n\n@id(\"jira-update-project-in-scope\")\npermit (\n  principal in UserGroup::\"mcp-jira-write\",\n  action == Jira::Action::\"update\",\n  resource is Jira::Project\n)\nwhen { principal in resource.scopes };\n\n@id(\"jira-update-issue-in-scope\")\npermit (\n  principal in UserGroup::\"mcp-jira-write\",\n  action == Jira::Action::\"update\",\n  resource is Jira::Issue\n)\nwhen { principal in resource.scopes };\n\n@id(\"jira-delete-issue-in-scope\")\npermit (\n  principal in UserGroup::\"mcp-jira-destructive\",\n  action == Jira::Action::\"delete\",\n  resource is Jira::Issue\n)\nwhen { principal in resource.scopes };\n"
        }
      ]
    },
    "policiesHash": "sha256:7d53d26505ab36c3ef6e8e9bd2cd591d0fd4e731345b047bc44c8a5e51d3191d"
