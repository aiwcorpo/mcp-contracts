      "schema": "// Reference fragment, not a policy of the platform: the schema of a service desk server in the form the platform requires.\n\nnamespace ServiceDesk {\n  // classification: category of the queue as reported by the adapter, normalized; optional (CC-057). A ticket is\n  // classified through its queue.\n  entity Queue {\n    id: String,\n    classification?: Set<String>,\n    scopes: Set<ResourceScope>,\n  };\n  entity Ticket in [Queue] {\n    id: String,\n    queue: Queue,\n    scopes: Set<ResourceScope>,\n  };\n\n  action \"read\", \"update\", \"delete\", \"admin\" appliesTo {\n    principal: [User],\n    resource: [Queue, Ticket],\n    context: RequestContext,\n  };\n}\n",
