{
  "description": "The claims change nothing about the checks: an expired token is rejected whatever else it carries.",
  "input": {
    "claims": {
      "iss": "https://idp.example/realms/corp",
      "aud": "mcp-gateway",
      "sub": "user-a",
      "exp": 1000,
      "iat": 4102444700,
      "vs": "team-a-dev"
    }
  },
  "expected": {
    "accepted": false,
    "reason": "expired",
    "ignoredClaims": [
      "vs"
    ]
  }
}
