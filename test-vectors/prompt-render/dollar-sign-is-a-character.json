{
  "description": "A dollar sign in a value is a character like any other, not a replacement pattern.",
  "input": {
    "prompt": {
      "name": "summarize_ticket",
      "definition": {
        "name": "summarize_ticket",
        "title": "Summarize a ticket",
        "description": "Summarize one service desk ticket for a handover.",
        "arguments": [
          {
            "name": "ticketId",
            "description": "Ticket id",
            "required": true
          },
          {
            "name": "note",
            "description": "A remark for the summary",
            "required": false
          }
        ]
      },
      "argumentRules": [
        {
          "name": "ticketId",
          "maxLength": 20,
          "pattern": "^SD-[0-9]{1,9}$",
          "type": "ServiceDesk::Ticket"
        },
        {
          "name": "note",
          "maxLength": 50,
          "pattern": "^.{1,50}$"
        }
      ],
      "messages": [
        {
          "role": "user",
          "text": "Summarize the ticket <ticket_id>{{ticketId}}</ticket_id> for a handover."
        },
        {
          "role": "assistant",
          "text": "I will read the ticket first."
        },
        {
          "role": "user",
          "text": "Remark: <note>{{note}}</note>"
        }
      ]
    },
    "typePatterns": {
      "ServiceDesk::Ticket": "^SD-[0-9]{1,9}$"
    },
    "arguments": {
      "ticketId": "SD-1042",
      "note": "costs $& more"
    },
    "era": "modern"
  },
  "expected": {
    "result": {
      "resultType": "complete",
      "description": "Summarize one service desk ticket for a handover.",
      "messages": [
        {
          "role": "user",
          "content": {
            "type": "text",
            "text": "Summarize the ticket <ticket_id>SD-1042</ticket_id> for a handover."
          }
        },
        {
          "role": "assistant",
          "content": {
            "type": "text",
            "text": "I will read the ticket first."
          }
        },
        {
          "role": "user",
          "content": {
            "type": "text",
            "text": "Remark: <note>costs $& more</note>"
          }
        }
      ]
    }
  }
}
