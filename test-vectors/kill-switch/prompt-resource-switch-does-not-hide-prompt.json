{
  "description": "A switch of a resource named like a prompt does not touch the prompt: the scopes are separate.",
  "kind": "primitive-switch",
  "input": {
    "switches": [
      {
        "scope": "resource",
        "serverId": "mcp-servicedesk",
        "resource": "summarize_ticket"
      }
    ],
    "target": {
      "kind": "prompt",
      "serverId": "mcp-servicedesk",
      "name": "summarize_ticket"
    },
    "event": "list"
  },
  "expected": {
    "listed": true
  }
}
