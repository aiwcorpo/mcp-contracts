{
  "description": "A URI that is the expansion of the template.",
  "kind": "template",
  "input": {
    "template": "servicedesk://ticket/{ticketId}",
    "variables": [
      {
        "name": "ticketId",
        "idPattern": "^SD-[0-9]{1,9}$"
      }
    ],
    "uri": "servicedesk://ticket/SD-1042"
  },
  "expected": {
    "match": true,
    "variables": {
      "ticketId": "SD-1042"
    }
  }
}
