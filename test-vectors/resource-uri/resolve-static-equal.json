{
  "description": "A static resource matches by equality of the URI.",
  "kind": "resolve",
  "input": {
    "resources": [
      {
        "name": "runbook",
        "uri": "servicedesk://runbook/escalation"
      }
    ],
    "templates": [
      {
        "name": "ticket",
        "uriTemplate": "servicedesk://ticket/{ticketId}",
        "variables": [
          {
            "name": "ticketId",
            "idPattern": "^SD-[0-9]{1,9}$"
          }
        ]
      }
    ],
    "uri": "servicedesk://runbook/escalation"
  },
  "expected": {
    "kind": "resource",
    "name": "runbook"
  }
}
