      {
        "name": "ref",
        "idPattern": "^[A-Za-z0-9_](?:[._/-][A-Za-z0-9_]|[A-Za-z0-9_])*$"
      },
      {
        "name": "filePath",
        "idPattern": "^[A-Za-z0-9_](?:[._/-][A-Za-z0-9_]|[A-Za-z0-9_])*$"
      }
    ],
    "uri": "gitlab://project/grp%2Fapp/blob/main/%2E%2E%2Fx"
