<?xml version="1.0" encoding="UTF-8"?>
<!--
  pl.aiwcorpo.mcp:mcp-policy-bundle - reference receiver of policy bundles (C7, CC-026, CC-028, CC-040, CC-041,
  CC-044, CC-045). Verifies and loads a bundle from bytes: Ed25519 signature with a key per channel, revision
  consistency and monotonicity, hardened tar reading, overrides content rules, Cedar strict validation, the
  permit lint and the scope mapping of entities/static.json. Fetching latest.json and the files is
  left to the component (gateway, starter). No Spring.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.aiwcorpo.mcp</groupId>
        <artifactId>mcp-contracts-parent</artifactId>
        <version>6.3.2</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mcp-policy-bundle</artifactId>
    <packaging>jar</packaging>
    <name>Aiwcorpo MCP Platform :: Policy bundle receiver</name>
    <description>Verifies and loads signed Cedar policy bundles (C7).</description>

    <dependencies>
        <dependency>
            <groupId>com.cedarpolicy</groupId>
            <artifactId>cedar-java</artifactId>
            <classifier>uber</classifier>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-cedar-entities</artifactId>
        </dependency>

        <!-- Already a runtime dependency of cedar-java; used here to read manifest.json, latest.json and the
             policy JSON form for the lint. Not exposed in the API. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>all,-missing</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
