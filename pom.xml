<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-contracts: machine-readable contracts of the MCP platform.

  Modules (all versioned together with the contracts, see README "Wersjonowanie"):
    - java/mcp-contracts        pl.aiwcorpo.mcp:mcp-contracts                 resources jar (+ test-vectors classifier)
    - java/mcp-cedar-entities   pl.aiwcorpo.mcp:mcp-cedar-entities            shared Cedar entity builder (C7, C9)
    - java/mcp-policy-bundle    pl.aiwcorpo.mcp:mcp-policy-bundle             reference policy bundle receiver (C7)
    - java/mcp-manifest         pl.aiwcorpo.mcp:mcp-manifest                  definitionHash and manifest rules (C6)
  The contract sources stay at the repository root (openapi/, schemas/, cedar/, test-vectors/, mocks/);
  the modules only package or test them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-contracts-parent</artifactId>
    <version>6.2.1</version>
    <packaging>pom</packaging>
    <name>Aiwcorpo MCP Platform :: Contracts (parent)</name>
    <url>https://github.com/aiwcorpo/mcp-contracts</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-contracts</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-contracts.git</connection>
    </scm>

    <!-- Published from CI only (.github/workflows/release.yml); the server id "github" gets its credentials from settings.xml. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages (aiwcorpo/mcp-contracts)</name>
            <url>https://maven.pkg.github.com/aiwcorpo/mcp-contracts</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>java/mcp-contracts</module>
        <module>java/mcp-cedar-entities</module>
        <module>java/mcp-policy-bundle</module>
        <module>java/mcp-manifest</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-26T00:00:00Z</project.build.outputTimestamp>
        <contracts.root>${maven.multiModuleProjectDirectory}</contracts.root>
        <cedar-java.version>4.10.0</cedar-java.version>
        <guava.version>33.5.0-jre</guava.version>
        <jackson.version>2.20.0</jackson.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-cedar-entities</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- The uber classifier bundles the native cedar_java_ffi libraries (macOS and Linux, x86_64 and
                 aarch64); the plain jar has none and fails at runtime. -->
            <dependency>
                <groupId>com.cedarpolicy</groupId>
                <artifactId>cedar-java</artifactId>
                <version>${cedar-java.version}</version>
                <classifier>uber</classifier>
            </dependency>
            <!-- Same version as the runtime dependency of cedar-java. Needed at compile time only to read the warnings of a
                 validation (ImmutableList in its response); provided scope, so no consumer gets a new artifact. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- Same line as cedar-java's own runtime dependency. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <systemPropertyVariables>
                            <contracts.root>${contracts.root}</contracts.root>
                        </systemPropertyVariables>
                        <!-- cedar-java loads its native library through JNI. -->
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. Done once here, inherited by all modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${contracts.root}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
