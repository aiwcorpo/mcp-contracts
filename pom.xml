<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-contracts: machine-readable contracts of the MCP platform.

  Modules (all versioned together with the contracts, see README "Versioning (SemVer)"):
    - java/mcp-contracts        pl.aiwcorpo.mcp:mcp-contracts                 resources jar (+ test-vectors classifier)
    - java/mcp-cedar-entities   pl.aiwcorpo.mcp:mcp-cedar-entities            shared Cedar entity builder (C7, C9)
    - java/mcp-policy-bundle    pl.aiwcorpo.mcp:mcp-policy-bundle             reference policy bundle receiver (C7)
    - java/mcp-manifest         pl.aiwcorpo.mcp:mcp-manifest                  definitionHash and manifest rules (C6)
  The contract sources stay at the repository root (openapi/, schemas/, cedar/, test-vectors/, mocks/);
  the modules only package or test them.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" child.project.url.inherit.append.path="false"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-contracts-parent</artifactId>
    <version>6.3.2</version>
    <packaging>pom</packaging>
    <name>Aiwcorpo MCP Platform :: Contracts (parent)</name>
    <description>Parent of the machine-readable contracts of the MCP platform: OpenAPI, JSON Schema, Cedar schema, test vectors and the Java libraries built on them.</description>
    <url>https://github.com/aiwcorpo/mcp-contracts</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>aiwcorpo</name>
        <url>https://github.com/aiwcorpo</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- The organization stands in for a person: Central requires developer information but not an e-mail address,
         and a published POM is public and permanent, so no private address goes into it. -->
    <developers>
        <developer>
            <id>aiwcorpo</id>
            <name>aiwcorpo</name>
            <organization>aiwcorpo</organization>
            <organizationUrl>https://github.com/aiwcorpo</organizationUrl>
        </developer>
    </developers>

    <!-- The repository holds all modules, so a module must not get /<artifactId> appended to these addresses. -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <url>https://github.com/aiwcorpo/mcp-contracts</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-contracts.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/aiwcorpo/mcp-contracts.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/aiwcorpo/mcp-contracts/issues</url>
    </issueManagement>

    <modules>
        <module>java/mcp-contracts</module>
        <module>java/mcp-cedar-entities</module>
        <module>java/mcp-policy-bundle</module>
        <module>java/mcp-manifest</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.build.outputTimestamp>2026-10-26T00:00:00Z</project.build.outputTimestamp>
        <contracts.root>${maven.multiModuleProjectDirectory}</contracts.root>
        <cedar-java.version>4.10.0</cedar-java.version>
        <guava.version>33.5.0-jre</guava.version>
        <jackson.version>2.20.0</jackson.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-cedar-entities</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- The uber classifier bundles the native cedar_java_ffi libraries (macOS and Linux, x86_64 and
                 aarch64); the plain jar has none and fails at runtime. -->
            <dependency>
                <groupId>com.cedarpolicy</groupId>
                <artifactId>cedar-java</artifactId>
                <version>${cedar-java.version}</version>
                <classifier>uber</classifier>
            </dependency>
            <!-- Same version as the runtime dependency of cedar-java. Needed at compile time only to read the warnings of a
                 validation (ImmutableList in its response); provided scope, so no consumer gets a new artifact. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!-- Same line as cedar-java's own runtime dependency. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                    <configuration>
                        <systemPropertyVariables>
                            <contracts.root>${contracts.root}</contracts.root>
                        </systemPropertyVariables>
                        <!-- cedar-java loads its native library through JNI. -->
                        <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.10.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. Done once here, inherited by all modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${contracts.root}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Maven Central. Not part of the normal build: `./mvnw -Prelease -Dgpg.skip verify` checks that the sources and javadoc
         jars build; the CI workflow signs and uploads the result itself (.github/workflows/release.yml). A manual release is
         `./mvnw -Prelease deploy`: signed with gpg, uploaded to the Central Portal as one bundle and left there for a person
         to publish (central.autoPublish=false, so a failed validation or a wrong version never reaches the public repository,
         which is immutable). Credentials: server id "central" in settings.xml (a Portal user token). The signing passphrase
         is read from the environment variable MAVEN_GPG_PASSPHRASE or from gpg-agent, never from the command line. -->
    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <central.autoPublish>false</central.autoPublish>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sources-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <deploymentName>mcp-contracts ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
