{
  "name": "@aiwcorpo/mcp-contracts",
  "version": "6.3.1",
  "description": "Kontrakty platformy MCP: OpenAPI, JSON Schema, schemat Cedar, wektory testowe, typy TS i handlery MSW.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiwcorpo/mcp-contracts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./msw": {
      "types": "./dist/msw/index.d.ts",
      "default": "./dist/msw/index.js"
    },
    "./types/credential-broker": {
      "types": "./dist/types/credential-broker.v1.d.ts"
    },
    "./types/gateway-admin": {
      "types": "./dist/types/gateway-admin.v1.d.ts"
    },
    "./types/portal-bff": {
      "types": "./dist/types/portal-bff.v1.d.ts"
    },
    "./types/schemas/*": {
      "types": "./dist/types/schemas/*.d.ts"
    },
    "./openapi/*": "./openapi/*",
    "./schemas/*": "./schemas/*",
    "./cedar/*": "./cedar/*",
    "./test-vectors/*": "./test-vectors/*",
    "./mocks/wiremock/*": "./mocks/wiremock/*",
    "./package.json": "./package.json",
    "./security/*": "./security/*"
  },
  "files": [
    "openapi/",
    "schemas/",
    "cedar/",
    "test-vectors/",
    "!test-vectors/keys/*NOT-FOR-PRODUCTION*",
    "security/",
    "mocks/",
    "dist/",
    "CONTRACT_CHANGES.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/bundle-openapi.mjs && node scripts/generate-mocks.mjs",
    "generate:mocks": "node scripts/generate-mocks.mjs",
    "generate:vectors": "node scripts/generate-vectors.mjs && node scripts/generate-totp-vectors.mjs && node scripts/generate-text-hygiene-vectors.mjs && node scripts/generate-cursor-vectors.mjs && node scripts/generate-endpoint-vectors.mjs",
    "generate:cedar": "node scripts/generate-cedar-vectors.mjs",
    "build": "node scripts/build-npm.mjs",
    "lint:openapi": "spectral lint --fail-severity=warn openapi/*.yaml openapi/bundled/*.yaml",
    "test:node": "node --test \"test/*.test.mjs\"",
    "test": "npm run lint:openapi && npm run build && npm run test:node",
    "smoke:wiremock": "scripts/smoke-wiremock.sh",
    "pack": "npm run build && node scripts/pack-release.mjs"
  },
  "peerDependencies": {
    "msw": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@stoplight/spectral-cli": "6.17.0",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "jose": "6.2.13",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
